// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  name           String?
  password       String?           // (Nullable) Kosong jika login via Google
  picture        String?
  role           String            @default("candidate") // Default: candidate
  accountStatus  String            @default("active")    // active, pending, suspended
  
  jobs           Job[]
  recruiterRequest RecruiterRequest?
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model RecruiterRequest {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName     String
  companyWebsite  String?
  companyEmail    String
  position        String
  reason          String    @db.Text
  
  status          String    @default("pending") // pending, approved, rejected
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?   // Admin user ID
  reviewNotes     String?   @db.Text
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Job {
  id           String        @id @default(uuid())
  title        String
  description  String
  requirements String        @db.Text
  company      String?
  location     String?
  
  recruiterId  String
  recruiter    User          @relation(fields: [recruiterId], references: [id])
  
  applications Application[]
  
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
}

model Application {
  id               String   @id @default(uuid())
  
  jobId            String
  job              Job      @relation(fields: [jobId], references: [id])
  
  userId           String?
  candidateName    String
  email            String
  resumeUrl        String
  resumeText       String?  @db.Text
  
  // AI Fields
  skillsExtracted  String[]
  summary          String?  @db.Text
  matchScore       Int?
  matchExplanation String?  @db.Text
  
  status           String   @default("applied")
  createdAt        DateTime @default(now())
}